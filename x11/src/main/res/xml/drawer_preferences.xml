<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Original Termux X11 Settings -->
    <PreferenceCategory android:title="">
        <Preference
            android:key="open_keyboard"
            android:title="Keyboard"
            android:icon="@drawable/ic_extra_key_keyboard" />
    </PreferenceCategory>

    <!-- Quick Actions -->
    <PreferenceCategory android:title="">
        <Preference
            android:key="select_controller"
            android:title="Controller"
            android:icon="@drawable/ic_extra_key_settings" />
    </PreferenceCategory>

    <!-- Info & Actions -->
    <PreferenceCategory android:title="">
        <Preference
            android:key="Exit"
            android:title="Exit app"
            android:icon="@drawable/lorie_ic_exit" />
    </PreferenceCategory>

</PreferenceScreen>
