<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Original Termux X11 Settings -->
    <PreferenceCategory android:title="Settings">
        <Preference
            android:key="full_settings"
            android:title="x11 Settings"
            android:icon="@android:drawable/ic_menu_preferences"
    </PreferenceCategory>

    <!-- Quick Actions -->
    <PreferenceCategory android:title="Quick Actions">
        <Preference
            android:key="select_controller"
            android:title="Controller"
            android:icon="@drawable/icon_menu_game_pad_open_shape"
            
        <SwitchPreferenceCompat
            android:key="hud_enabled"
            android:title="Enable HUD"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="start_debug"
            android:title="debug"
            android:icon="@android:drawable/ic_menu_info_details"
    </PreferenceCategory>

    <!-- Info & Actions -->
    <PreferenceCategory android:title="Information">
        <Preference
            android:key="exit"
            android:title="Exit app"
            android:icon="@android:drawable/ic_menu_close_clear_cancel"
    </PreferenceCategory>

</PreferenceScreen>
